// Cloudflare Worker built by @opennextjs/cloudflare: Next.js runs in the Worker, and static
// files (including the prerendered pages) are Workers static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bannertimer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bannertimer" }],
  "observability": { "enabled": true }
}
